#!/usr/bin/env bash
# MCP launcher shipped in the plugin (.mcp.json points here): finds hyprcage,
# installs it on the first run, updates it when the plugin moved to a newer
# release, then serves MCP on stdio. The plugin's version pins the release,
# so plugin and binary evolve together. A binary built from source ("dev")
# or newer than the plugin is left alone.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
want=v$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$root/.claude-plugin/plugin.json" | head -1)
find_bin() {
  command -v hyprcage 2>/dev/null && return
  [ -x "$HOME/.local/bin/hyprcage" ] && echo "$HOME/.local/bin/hyprcage"
}
# A release tag older than the one the plugin pins.
outdated() {
  local have; have=$("$1" version 2>/dev/null | head -1) || return 1
  # A build from a checkout (git describe: vX.Y.Z-N-gHASH) is left alone.
  case "$have" in *-g[0-9a-f]*) return 1 ;; v[0-9]*) ;; *) return 1 ;; esac
  [ "$have" != "$want" ] && [ "$(printf '%s\n%s\n' "$have" "$want" | sort -V | head -1)" = "$have" ]
}
bin=$(find_bin || true)
if [ -z "$bin" ]; then
  echo "hyprcage: first run, installing the binary ($want)" >&2
elif outdated "$bin"; then
  echo "hyprcage: the plugin moved to $want, updating the binary" >&2
  bin=
fi
if [ -z "$bin" ]; then
  HYPRCAGE_VERSION=${HYPRCAGE_VERSION:-$want} bash "$root/install.sh" --binary-only \
    || { echo "hyprcage: could not install the binary; from a terminal: bash $root/install.sh" >&2; exit 1; }
  bin=$(find_bin || true)
  [ -n "$bin" ] || { echo "hyprcage: binary still not found after installing" >&2; exit 1; }
fi
exec "$bin" mcp

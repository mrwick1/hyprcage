#!/usr/bin/env bash
# MCP launcher for bare, the e2e browser, shipped in the plugin (.mcp.json
# points here). bare-mcp lives next to offstage, in the same directory, and
# needs its sibling bare-drive there. When one is missing, install.sh installs
# both. Then it serves MCP on stdio. BARE_MCP_REPORT=offstage sends bare's
# problem reports through offstage's report_issue.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
find_bin() {
  local d
  for d in "${OFFSTAGE_BIN_DIR:-$HOME/.local/bin}" "$(dirname "$(command -v offstage 2>/dev/null || echo /)")"; do
    [ -x "$d/bare-mcp" ] && [ -x "$d/bare-drive" ] && { echo "$d/bare-mcp"; return; }
  done
  return 1
}
bin=$(find_bin || true)
if [ -z "$bin" ]; then
  echo "bare: first run, installing bare-mcp and bare-drive" >&2
  bash "$root/install.sh" --bare-only >&2 \
    || { echo "bare: could not install; from a terminal: bash $root/install.sh" >&2; exit 1; }
  bin=$(find_bin || true)
  [ -n "$bin" ] || { echo "bare: bare-mcp still not found after installing" >&2; exit 1; }
fi
BARE_MCP_REPORT=offstage exec "$bin"

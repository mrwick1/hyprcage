#!/usr/bin/env bash
# MCP launcher shipped in the plugin (.mcp.json points here): finds offstage,
# installs it on the first run, updates it when the plugin moved to a newer
# release, then serves MCP on stdio. The plugin's version pins the release,
# so plugin and binary evolve together. A binary built from source ("dev")
# or newer than the plugin is left alone.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
want=v$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$root/.claude-plugin/plugin.json" | head -1)
find_bin() {
  command -v offstage 2>/dev/null && return
  [ -x "$HOME/.local/bin/offstage" ] && echo "$HOME/.local/bin/offstage"
}
# True when release $1 sorts before $2 (vX.Y.Z or vX.Y.Z-pre), in semver order:
# a release ranks above its prereleases; numeric identifiers compare as numbers.
older() {
  local a=${1#v} b=${2#v} ca cb pa= pb= i x y p q IFS=.
  ca=${a%%-*}; cb=${b%%-*}
  [ "$ca" = "$a" ] || pa=${a#*-}
  [ "$cb" = "$b" ] || pb=${b#*-}
  read -ra p <<<"$ca"; read -ra q <<<"$cb"
  for i in 0 1 2; do
    x=${p[i]:-0} y=${q[i]:-0}
    [ "$x" -eq "$y" ] || { [ "$x" -lt "$y" ]; return; }
  done
  [ -n "$pa" ] || return 1
  [ -n "$pb" ] || return 0
  read -ra p <<<"$pa"; read -ra q <<<"$pb"
  for ((i = 0; i < ${#p[@]} && i < ${#q[@]}; i++)); do
    x=${p[i]} y=${q[i]}
    [ "$x" = "$y" ] && continue
    if [[ $x == *[!0-9]* || $y == *[!0-9]* ]]; then [[ $x < $y ]]; else [ "$x" -lt "$y" ]; fi
    return
  done
  [ "${#p[@]}" -lt "${#q[@]}" ]
}
# A release tag older than the one the plugin pins.
outdated() {
  local have; have=$("$1" version 2>/dev/null | head -1) || return 1
  # A build from a checkout (git describe: vX.Y.Z-N-gHASH) is left alone.
  # "source" came from a plugin cache that install.sh took for a checkout.
  case "$have" in *-g[0-9a-f]*) return 1 ;; v[0-9]* | source) ;; *) return 1 ;; esac
  [ "$have" != "$want" ] && { [ "$have" = source ] || older "$have" "$want"; }
}
# Sourced by tests/launcher_semver_test.sh: stop after the functions.
[ "${BASH_SOURCE[0]}" = "$0" ] || return 0
bin=$(find_bin || true)
if [ -z "$bin" ]; then
  echo "offstage: first run, installing the binary ($want)" >&2
elif outdated "$bin"; then
  echo "offstage: the plugin moved to $want, updating the binary" >&2
  bin=
fi
if [ -z "$bin" ]; then
  # The plugin cache has go.mod but is not a checkout: download the release.
  OFFSTAGE_VERSION=${OFFSTAGE_VERSION:-$want} OFFSTAGE_FROM_SOURCE=${OFFSTAGE_FROM_SOURCE:-0} \
    bash "$root/install.sh" --binary-only \
    || { echo "offstage: could not install the binary; from a terminal: bash $root/install.sh" >&2; exit 1; }
  bin=$(find_bin || true)
  [ -n "$bin" ] || { echo "offstage: binary still not found after installing" >&2; exit 1; }
fi
# An existing offstage binary can outlive a removed browser dependency.
browser_dir=$(dirname "$bin")
if [ ! -x "$browser_dir/bare-mcp" ] || [ ! -x "$browser_dir/bare-drive" ]; then
  OFFSTAGE_BIN_DIR="$browser_dir" bash "$root/install.sh" --bare-only >&2 \
    || { echo "offstage: could not install required Bare" >&2; exit 1; }
fi
exec "$bin" mcp
